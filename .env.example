# Copy to .env. Deployment uses your AWS CLI/SSO profile; never put AWS access keys here.
# Replace your-selected-region with the Region assigned to your AWS project.
AWS_REGION=your-selected-region
# Optional: set this when using a named profile such as `sai`.
# AWS_PROFILE=sai
STACK_NAME=civicloop
SITE_ORIGIN=https://civicloop-coral.vercel.app
# Populated by scripts/deploy.mjs after the first successful deploy.
API_BASE_URL=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_DOMAIN=
# Server-side only. Never prefix these with VITE_ or expose them in browser code.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
MEDIA_BUCKET_NAME=your-private-media-bucket
# Sender mailbox used for authority report mail.
SES_FROM_EMAIL=
# Yahoo Mail first, SES fallback. A Yahoo app password is required; a Google API key cannot send Yahoo mail.
# The deploy script stores the app password in AWS Secrets Manager. Never commit the filled .env.
YAHOO_SECRET_ID=civicloop/yahoo-smtp
YAHOO_FROM_EMAIL=civicloop@yahoo.com
YAHOO_APP_PASSWORD=
# Gmail API primary when configured; SES remains fallback. GMAIL_API keys cannot send mail.
# Use a Gmail sender account authorized with the gmail.send scope and offline access.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=
GMAIL_SECRET_ID=civicloop/gmail
# Instagram Login publishing. Add these only to the local, ignored .env file.
# Use a professional Instagram account and a long-lived user token with
# instagram_business_basic and instagram_business_content_publish.
INSTAGRAM_APP_ID=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_TOKEN_EXPIRES_AT=
# Optional until Meta supplies an expiry; add it to enable automatic refresh.
# The deployment stores the token in Secrets Manager in ap-south-1.
# Example: INSTAGRAM_APP_ID=123456789012345
# Example: INSTAGRAM_USER_ID=17841400000000000
# Example: INSTAGRAM_ACCESS_TOKEN=IGQVJ...long-lived-user-token
# Example: INSTAGRAM_TOKEN_EXPIRES_AT=2026-12-01T00:00:00Z
# Example: INSTAGRAM_SECRET_ID=civicloop/instagram
INSTAGRAM_SECRET_ID=
DEMO_INBOX_EMAIL=
# Use only official contacts you have confirmed. Ward numbers match GBA's 369-ward map.
# Example: {"Bengaluru":{"department":"Greater Bengaluru Authority","wards":{"25":{"department":"Bengaluru West City Corporation","email":"verified-contact@example.org"}}}}
AUTHORITY_EMAILS_JSON='{}'
