# Public app configuration. These values identify AWS resources; they are not credentials.
# Replace your-selected-region with the Region assigned to your AWS project.
AWS_REGION=your-selected-region
API_BASE_URL=https://your-api.example.com
COGNITO_USER_POOL_ID=your_user_pool_id
COGNITO_APP_CLIENT_ID=your_public_app_client_id
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Keep the matching Google client secret in server-side/Cognito configuration only.
# Do not put it in frontend code or any VITE_ variable.
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_google_oauth_client_secret

# Server-side only. Never prefix these with VITE_ or expose them in browser code.
BEDROCK_MODEL_ID=your-enabled-model-id
MEDIA_BUCKET_NAME=your-private-media-bucket
SES_FROM_EMAIL=verified-sender@example.com
DEMO_INBOX_EMAIL=your-test-inbox@example.com
